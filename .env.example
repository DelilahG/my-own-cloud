# ---------------------------------------------------------------
# My Own Cloud — environment configuration
# Copy to `.env` (or run `npm run setup`, which does it for you and
# generates a random local database password). Never commit `.env`.
# ---------------------------------------------------------------

NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# Browser origin(s) allowed to call the API (comma-separated).
# In development this is the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL --------------------------------------------------
# Project-local PostgreSQL started by `npm run db:start`.
LOCAL_PG_PORT=5433
LOCAL_PG_PASSWORD=change-me-local-db-password

# Main database used by the app.
DATABASE_URL=postgres://postgres:change-me-local-db-password@localhost:5433/myowncloud
# Separate, disposable database used ONLY by automated tests.
# Its name must end in "_test" — the test suite refuses to run otherwise.
TEST_DATABASE_URL=postgres://postgres:change-me-local-db-password@localhost:5433/myowncloud_test

# --- File storage ------------------------------------------------
# Private directory for uploaded file bytes (relative to server/).
STORAGE_DIR=./storage
# Largest single upload, in megabytes.
MAX_FILE_SIZE_MB=100
# Storage quota given to each new account, in megabytes.
DEFAULT_QUOTA_MB=1024

# --- Sessions ----------------------------------------------------
SESSION_TTL_DAYS=7
# Send cookies only over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# Set to 1 when running behind a reverse proxy (needed for correct client IPs).
# TRUST_PROXY=1
